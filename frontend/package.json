{
  "name": "log-insight-frontend",
  "productName": "Log Insight",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop log investigation client",
  "main": ".webpack/main/index.cjs",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "typecheck": "tsc --noEmit",
    "generate:api": "openapi-typescript ../docs/api/openapi.yaml -o src/api/schema.d.ts",
    "mock": "node scripts/mock.mjs",
    "test": "vitest run",
    "build": "electron-forge package",
    "verify:mock": "node scripts/verify-mock.mjs"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-webpack": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@stoplight/prism-cli": "^5.14.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "css-loader": "^6.11.0",
    "electron": "44.5.0",
    "fork-ts-checker-webpack-plugin": "^7.3.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.86.0",
    "style-loader": "^3.3.4",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.0",
    "electron-squirrel-startup": "^1.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "author": "AI Assisted Log"
}
